<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:background="@color/onboarding_grey">


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.80" />

    <RelativeLayout
        android:id="@+id/permMedia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/theme_selection_bg_rounded"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottom"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginVertical="16dp"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/permAllTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/permission_onboarding_perm_media"
            android:text="All File Access"
            android:textAlignment="center"
            android:textAppearance="@style/VLC.Onboarding.Title"
            android:textSize="16sp"
            android:textStyle="bold"
            app:srcCompat="@drawable/ic_perm_media" />

        <TextView
            android:id="@+id/permAllDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/permAllTitle"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/permission_onboarding_perm_media"
            android:text="Supports A Wide Range Of View Formats"
            android:textAlignment="center"
            android:textAppearance="@style/VLC.Onboarding.Text"
            app:srcCompat="@drawable/ic_perm_media" />

        <ImageView
            android:id="@+id/permAllImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/permAllTitle"
            android:layout_alignBottom="@+id/permAllDesc"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_toEndOf="@+id/permAllDesc"
            android:contentDescription="@string/permission_onboarding_perm_all"
            app:srcCompat="@drawable/check_circle" />


    </RelativeLayout>

    <TextView
        android:id="@+id/permission_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:text="@string/allow_permissions"
        android:textAlignment="center"
        android:textAppearance="@style/VLC.Onboarding.Title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/permission_img"
        app:layout_constraintBottom_toTopOf="@+id/permMedia"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toEndOf="@+id/permission_title"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:padding="16dp"
        android:text="@string/permission_media"
        android:textAlignment="center"
        android:textAppearance="@style/VLC.Onboarding.Text"
        app:layout_constraintBottom_toTopOf="@+id/permMedia"
        app:layout_constraintEnd_toEndOf="@+id/permission_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/permission_title" />

</androidx.constraintlayout.widget.ConstraintLayout>