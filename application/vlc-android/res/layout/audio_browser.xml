<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="empty"
            type="boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            layout="@layout/button_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/header_view_layout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="@{empty ? View.GONE : View.VISIBLE}"
            app:layout_constraintTop_toBottomOf="@+id/searchButton">

            <TextView
                android:id="@+id/audio_count_text_view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:textSize="16sp"
                tools:text="9 Folders" />

            <ImageView
                android:id="@+id/play_all_iv"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lb_selectable_item_rounded_rect"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/play_music" />

        </LinearLayout>

        <com.video.offline.videoplayer.gui.view.SwipeRefreshLayout
            android:id="@+id/swipeLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_view_layout">

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header_view_layout">

                <include layout="@layout/audio_recyclerview" />

                <include layout="@layout/audio_recyclerview" />

                <include layout="@layout/audio_recyclerview" />

                <include layout="@layout/audio_recyclerview" />

                <include layout="@layout/audio_recyclerview" />
            </androidx.viewpager.widget.ViewPager>
        </com.video.offline.videoplayer.gui.view.SwipeRefreshLayout>

        <com.video.offline.videoplayer.gui.view.FastScroller
            android:id="@+id/songs_fast_scroller"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/swipeLayout"
            app:layout_constraintTop_toTopOf="parent" />

        <com.video.offline.videoplayer.gui.view.EmptyLoadingStateView
            android:id="@+id/audio_empty_loading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:empty_text="@string/nomedia"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>